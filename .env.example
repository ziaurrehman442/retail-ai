# Copy this file to .env and replace the example values.
# This address receives administrator privileges when its owner verifies by OTP.
NIMBUS_ADMIN_EMAIL=admin@yourcompany.com

# Set to production only when deploying behind HTTPS with Waitress or another WSGI server.
NIMBUS_ENV=development

# Public HTTPS origin used for canonical metadata and the XML sitemap.
NIMBUS_PUBLIC_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NIMBUS_SECRET_KEY=replace-with-a-long-random-secret

# SMTP credentials used to deliver passwordless email sign-in codes.
NIMBUS_SMTP_HOST=smtp.yourprovider.com
NIMBUS_SMTP_PORT=587
NIMBUS_SMTP_USERNAME=your-sender@yourcompany.com
NIMBUS_SMTP_PASSWORD=your-smtp-app-password
NIMBUS_SMTP_FROM="Nexa <your-sender@yourcompany.com>"
NIMBUS_SMTP_STARTTLS=true
NIMBUS_SMTP_SSL=false

OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# Testing default: 30 free chat requests per month. Set 0 for no monthly cap.
NIMBUS_FREE_REQUESTS_PER_MONTH=30

# Only enable this on a private local development machine without SMTP.
# Codes are printed to the Python console instead of being emailed.
NIMBUS_ALLOW_CONSOLE_OTP=false

# Set true only when serving the dashboard over HTTPS.
NIMBUS_COOKIE_SECURE=false
